#!/bin/bash
# Launcher for NVIDIA's official GeForce NOW Linux client.
#
# Trimmed re-implementation of the flatpak's files/bin/GeForceNOW run():
# all flatpak-update / GeForceNOW_Downloader / flatpak-spawn logic is
# removed since there is no flatpak stack inside the snap and updates are
# handled by `snap refresh` instead. The in-app restart request (the app
# drops a restart.json file when it wants to be relaunched) is preserved.
set -u

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/NVIDIA/GeForceNOW"
RESTART_FILE="$STATE_DIR/restart.json"
mkdir -p "$STATE_DIR"

unset LD_PRELOAD

# The client is SDL2-based (not Electron). SDL auto-detects a video driver,
# but under XWayland it falls back to X11 RandR (libXrandr / `xrandr
# --query`) to enumerate modes and refresh rates, which mutter's XWayland
# integration can report incorrectly for HiDPI / high-refresh outputs.
# Force SDL's native Wayland driver whenever a real compositor socket is
# available so the app queries the compositor directly instead.
if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "${XDG_RUNTIME_DIR:-}/${WAYLAND_DISPLAY}" ]; then
  export SDL_VIDEODRIVER=wayland
fi

cd "$SNAP/cef" || exit 1

status=0
while true; do
  ./GeForceNOW "$@"
  status=$?
  if [ -f "$RESTART_FILE" ]; then
    rm -f "$RESTART_FILE"
    continue
  fi
  break
done

exit "$status"
